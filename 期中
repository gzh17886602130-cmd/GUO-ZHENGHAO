# 从 keras.layers 导入常用的层：卷积、池化、输入、全连接、展平、丢弃层
from keras.layers import Conv2D, MaxPooling2D, Input, Dense, Flatten, Dropout

# 从 keras.models 导入 Sequential 顺序模型类
from keras.models import Sequential

# 创建一个空的顺序模型实例，命名为 alexnet
alexnet = Sequential()

# 添加输入层，指定输入张量形状为 (227, 227, 3)（高、宽、通道）
alexnet.add(Input(shape=(227, 227, 3)))

# 添加第一个卷积层：
# filters=96 -> 96 个卷积核；kernel_size=(11,11) -> 卷积核大小 11x11；
# strides=4 -> 步长为 4；activation="relu" -> 使用 ReLU 激活
alexnet.add(Conv2D(filters=96, kernel_size=(11,11), strides=4, activation="relu"))

# 添加最大池化层，以 3x3 窗口进行池化，strides=2 表示步长为 2（用于下采样）
alexnet.add(MaxPooling2D(pool_size=(3,3), strides=2))

# 添加第二个卷积层：
# filters=256 -> 256 个卷积核；kernel_size=(5,5)；
# strides=1 -> 步长为 1；padding="same" -> 保持输入/输出空间尺寸一致；
# activation="relu" -> 使用 ReLU 激活
alexnet.add(Conv2D(filters=256, kernel_size=(5,5), strides=1, activation="relu", padding="same"))

# 再添加一个最大池化层（3x3 窗口，步长 2）
alexnet.add(MaxPooling2D(pool_size=(3,3), strides=2))

# 将多维特征图展平为 1D 向量，准备输入全连接层
alexnet.add(Flatten())

# 第一个大容量全连接层，units=4096，使用 ReLU 激活
alexnet.add(Dense(units=4096, activation="relu"))

# 加入 Dropout 层，比例 0.5，用于在训练时随机丢弃一半神经元以降低过拟合
alexnet.add(Dropout(0.5))

# 第二个 4096 单元的全连接层，使用 ReLU
alexnet.add(Dense(units=4096, activation="relu"))

# 再次添加 Dropout(0.5)
alexnet.add(Dropout(0.5))

# 输出层：1000 个神经元（通常对应 ImageNet 的 1000 类）
# 注意：此处 activation="relu" 会输出非概率值，若用于分类通常用 softmax。
alexnet.add(Dense(1000, activation="relu"))

# 打印模型结构摘要（每层输出形状、参数数量等）
alexnet.summary()

