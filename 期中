# 导入 Keras 深度学习框架
import keras

# 从 keras 中导入 layers 模块（包含各种神经网络层）
from keras import layers

# 从 keras.layers 模块中分别导入常用层：全连接层 Dense、输入层 Input、
# 卷积层 Conv2D、平均池化层 AveragePooling2D、展平层 Flatten
from keras.layers import Dense, Input, Conv2D, AveragePooling2D, Flatten

# 从 keras.models 中导入 Sequential 顺序模型（按层顺序堆叠网络）
from keras.models import Sequential

# 创建一个空的顺序模型（Sequential 模型）
lenet5 = Sequential()

# 添加第一个卷积层：
# filters=16 表示使用 16 个卷积核（即输出 16 个特征图）
# kernel_size=(5,5) 表示卷积核的大小为 5×5
# activation="sigmoid" 使用 sigmoid 激活函数（在早期的 LeNet 中使用）
lenet5.add(Conv2D(filters=16, kernel_size=(5,5), activation="sigmoid"))

# 添加一个平均池化层（AveragePooling2D）
# pool_size=2 表示池化窗口为 2×2，用于降低特征图尺寸（下采样）
lenet5.add(AveragePooling2D(pool_size=2))

# 添加展平层（Flatten）
# 将多维特征图拉平成一维向量，以便传入全连接层
lenet5.add(Flatten())

# 添加第一个全连接层（Dense）
# 120 表示输出节点数为 120
# activation="sigmoid" 表示使用 sigmoid 激活函数
lenet5.add(Dense(120, activation="sigmoid"))

# 添加第二个全连接层
# 输出节点数为 64
# 激活函数仍为 sigmoid
lenet5.add(Dense(64, activation="sigmoid"))

# 添加输出层
# 输出节点数为 10（对应 Fashion MNIST 数据集中 10 个类别）
# 激活函数为 sigmoid（用于分类输出）
lenet5.add(Dense(10, activation="sigmoid"))

# 打印模型结构摘要（每层的类型、输出形状、参数数量等）
lenet5.summary()

# 加载 Keras 自带的 Fashion-MNIST 数据集
